# ============================================================================
# Development Environment Variables
# ============================================================================
# This file contains development-specific environment variables.
# Loaded automatically when running npm run dev

# API Configuration - Using Vite Proxy (no CORS issues)
# The proxy in vite.config.ts forwards /api to http://localhost:8080/api
#VITE_API_BASE_URL=/api

# Alternative: Direct backend URL (requires backend CORS configuration)
VITE_API_BASE_URL=http://localhost:8080/api

# App Configuration
VITE_APP_NAME=Clinic Application (Dev)
VITE_APP_VERSION=1.0.0-dev

# Feature Flags
VITE_ENABLE_DEBUG_MODE=true
