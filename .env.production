# ============================================================================
# Production Environment Variables
# ============================================================================
# This file contains production-specific environment variables.
# Should be loaded when building for production (npm run build)

# API Configuration - Update this to your production API URL
VITE_API_BASE_URL=https://api.yourdomain.com/api

# App Configuration
VITE_APP_NAME=Clinic Application
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=false
