# ============================================================================
# Local Environment Variables Example
# ============================================================================
# Copy this file to .env.local and customize for your local setup
# .env.local is ignored by git and won't be committed

# API Configuration - Change this to match your local backend
VITE_API_BASE_URL=http://localhost:8080/api

# Development Settings
VITE_ENABLE_DEBUG_MODE=true

# Optional: Override app name for local environment
# VITE_APP_NAME=Clinic App (My Local)

# Add any other personal environment variables here
